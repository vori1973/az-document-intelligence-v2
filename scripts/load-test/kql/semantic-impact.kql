// semantic-impact.kql
// Compare p50/p95/p99 latency before and after enabling the semantic ranker.
// Run in Log Analytics against an Azure AI Search resource with diagnostics enabled.
//
// Azure Search logs do not tag queries by type (semantic vs hybrid).
// This query compares two explicit time windows — set them to bracket your
// load test runs before and after enabling --semantic-search on the service.
//
// How to use:
//   1. Run load_test.py --profile hybrid   → note the end time (before_end)
//   2. az search service update --semantic-search free
//   3. Run load_test.py --profile semantic → note the start time (after_start)
//   4. Set the four variables below and run this query
//
// Columns: window, p50, p95, p99, qps, total_requests

let before_start = datetime("2026-01-01T00:00:00Z");  // ← set to start of hybrid run
let before_end   = datetime("2026-01-01T00:01:00Z");  // ← set to end   of hybrid run
let after_start  = datetime("2026-01-01T00:02:00Z");  // ← set to start of semantic run
let after_end    = datetime("2026-01-01T00:03:00Z");  // ← set to end   of semantic run

let baseline = AzureDiagnostics
| where ResourceProvider == "MICROSOFT.SEARCH"
| where OperationName startswith "Query."
| where resultSignature_d == 200
| where TimeGenerated between (before_start .. before_end)
| summarize
    p50            = percentile(DurationMs, 50),
    p95            = percentile(DurationMs, 95),
    p99            = percentile(DurationMs, 99),
    total_requests = count()
| extend
    window = "before (hybrid)",
    qps    = round(todouble(total_requests) / datetime_diff("second", before_end, before_start), 2);

let with_semantic = AzureDiagnostics
| where ResourceProvider == "MICROSOFT.SEARCH"
| where OperationName startswith "Query."
| where resultSignature_d == 200
| where TimeGenerated between (after_start .. after_end)
| summarize
    p50            = percentile(DurationMs, 50),
    p95            = percentile(DurationMs, 95),
    p99            = percentile(DurationMs, 99),
    total_requests = count()
| extend
    window = "after  (semantic)",
    qps    = round(todouble(total_requests) / datetime_diff("second", after_end, after_start), 2);

union baseline, with_semantic
| project window, p50, p95, p99, qps, total_requests
