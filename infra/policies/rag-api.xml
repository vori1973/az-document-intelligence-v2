<!--
  API-scope policy for the RAG demo API (tasks 5.3 / 5.4 / 5.7).

  Runs for BOTH demo operations so that `/rag/baseline` and `/rag/apim-built-in`
  differ only by cache policy, never by request shaping, validation, or backend
  contract (see openspec/changes/add-apim-exact-cache-demo/design.md,
  "Keep APIM operations as policy variants over one backend").

  Responsibilities, in order:
    1. Establish the gateway-authoritative correlation id.
    2. Overwrite every caller-supplied trusted context header with the
       deployment-managed named values (spec: "Caller supplies cache partition
       values").
    3. Bounded JSON body handling: media type, byte ceiling, question presence,
       question length.
    4. Exact normalization -> SHA-256 -> namespaced cache key -> opaque key id,
       reproducing query/rag/normalize.py exactly.
    5. Managed-identity authentication to the query Function App backend.
    6. Non-sensitive proof headers on every response, success or failure.

  Named values referenced here are created by infra/modules/apim.bicep. XML
  attributes that contain a C# expression use single quotes so the expression's
  own double quotes need no escaping; `<`, `>` and `&` are still XML-escaped.
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Gateway-authoritative correlation. The caller cannot choose it. -->
    <set-variable name="correlationId" value="@(context.RequestId.ToString())" />

    <!-- Cache bookkeeping defaults. Operation policies narrow these; the
         outbound section reads them with GetValueOrDefault so a short-circuit
         return still produces a complete, honest set of proof headers. -->
    <set-variable name="cacheType" value='@(context.Operation.Id == "rag-apim-built-in" ? "apim-built-in" : "none")' />
    <set-variable name="cacheOutcome" value="BYPASS" />
    <set-variable name="cacheEligible" value="@(false)" />
    <set-variable name="cacheKey" value="" />
    <set-variable name="cacheKeyId" value="" />

    <!-- 2. Trusted context headers. `override` replaces any caller-supplied
         value; the backend (query/rag/headers.py) treats these as trusted. -->
    <set-header name="X-Demo-Correlation-Id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="X-Demo-Generation" exists-action="override">
      <value>{{rag-knowledge-generation}}</value>
    </set-header>
    <set-header name="X-Demo-Security-Scope" exists-action="override">
      <value>{{rag-security-scope}}</value>
    </set-header>
    <set-header name="X-Demo-Prompt-Version" exists-action="override">
      <value>{{rag-prompt-version}}</value>
    </set-header>
    <set-header name="X-Demo-Model-Version" exists-action="override">
      <value>{{rag-logical-model-version}}</value>
    </set-header>
    <set-header name="X-Demo-Cache-Mode" exists-action="override">
      <value>@((string)context.Variables["cacheType"])</value>
    </set-header>
    <!-- Never forward gateway credentials or caller Authorization material to
         the backend; step 5 replaces Authorization with a managed-identity token. -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />

    <!-- 3a. Media type. Anything that is not JSON cannot be an eligible query. -->
    <choose>
      <when condition='@(!context.Request.Headers.GetValueOrDefault("Content-Type", "").Contains("application/json"))'>
        <return-response>
          <set-status code="415" reason="Unsupported Media Type" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-demo-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="x-demo-cache" exists-action="override">
            <value>BYPASS</value>
          </set-header>
          <set-header name="x-demo-cache-type" exists-action="override">
            <value>@((string)context.Variables["cacheType"])</value>
          </set-header>
          <set-header name="x-demo-cache-eligible" exists-action="override">
            <value>false</value>
          </set-header>
          <set-header name="x-demo-generation" exists-action="override">
            <value>{{rag-knowledge-generation}}</value>
          </set-header>
          <set-body>@("{\"error\":\"unsupported_media_type\",\"message\":\"Content-Type must be application/json\",\"correlationId\":\"" + (string)context.Variables["correlationId"] + "\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <!-- 3b. Bounded body read. Declared Content-Length is checked first so an
         oversized body is rejected before it is materialized as a string; the
         second check covers chunked requests with no declared length. -->
    <choose>
      <when condition='@{ int declaredLength; return int.TryParse(context.Request.Headers.GetValueOrDefault("Content-Length", "0"), out declaredLength) &amp;&amp; declaredLength &gt; int.Parse("{{rag-max-request-bytes}}"); }'>
        <return-response>
          <set-status code="413" reason="Payload Too Large" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-demo-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="x-demo-cache" exists-action="override">
            <value>BYPASS</value>
          </set-header>
          <set-header name="x-demo-cache-type" exists-action="override">
            <value>@((string)context.Variables["cacheType"])</value>
          </set-header>
          <set-header name="x-demo-cache-eligible" exists-action="override">
            <value>false</value>
          </set-header>
          <set-header name="x-demo-generation" exists-action="override">
            <value>{{rag-knowledge-generation}}</value>
          </set-header>
          <set-body>@("{\"error\":\"request_too_large\",\"message\":\"request body exceeds the configured limit\",\"correlationId\":\"" + (string)context.Variables["correlationId"] + "\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <set-variable name="requestBodyText" value='@{
      try {
        var raw = context.Request.Body.As&lt;string&gt;(preserveContent: true);
        return raw ?? "";
      } catch (Exception) {
        return "";
      }
    }' />

    <choose>
      <when condition='@(((string)context.Variables["requestBodyText"]).Length &gt; int.Parse("{{rag-max-request-bytes}}"))'>
        <return-response>
          <set-status code="413" reason="Payload Too Large" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-demo-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="x-demo-cache" exists-action="override">
            <value>BYPASS</value>
          </set-header>
          <set-header name="x-demo-cache-type" exists-action="override">
            <value>@((string)context.Variables["cacheType"])</value>
          </set-header>
          <set-header name="x-demo-cache-eligible" exists-action="override">
            <value>false</value>
          </set-header>
          <set-header name="x-demo-generation" exists-action="override">
            <value>{{rag-knowledge-generation}}</value>
          </set-header>
          <set-body>@("{\"error\":\"request_too_large\",\"message\":\"request body exceeds the configured limit\",\"correlationId\":\"" + (string)context.Variables["correlationId"] + "\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <!-- 3c. Extract the question. A malformed body yields an empty string and
         is rejected below rather than throwing out of the policy. -->
    <set-variable name="questionRaw" value='@{
      try {
        var text = (string)context.Variables["requestBodyText"];
        if (string.IsNullOrEmpty(text)) { return ""; }
        var body = Newtonsoft.Json.Linq.JObject.Parse(text);
        var token = body["question"];
        if (token == null || token.Type != Newtonsoft.Json.Linq.JTokenType.String) { return ""; }
        return ((string)token) ?? "";
      } catch (Exception) {
        return "";
      }
    }' />

    <choose>
      <when condition='@(string.IsNullOrWhiteSpace((string)context.Variables["questionRaw"]))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-demo-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="x-demo-cache" exists-action="override">
            <value>BYPASS</value>
          </set-header>
          <set-header name="x-demo-cache-type" exists-action="override">
            <value>@((string)context.Variables["cacheType"])</value>
          </set-header>
          <set-header name="x-demo-cache-eligible" exists-action="override">
            <value>false</value>
          </set-header>
          <set-header name="x-demo-generation" exists-action="override">
            <value>{{rag-knowledge-generation}}</value>
          </set-header>
          <set-body>@("{\"error\":\"invalid_request\",\"message\":\"a non-empty string question is required\",\"correlationId\":\"" + (string)context.Variables["correlationId"] + "\"}")</set-body>
        </return-response>
      </when>
      <when condition='@(((string)context.Variables["questionRaw"]).Length &gt; int.Parse("{{rag-max-question-length}}"))'>
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-demo-correlation-id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
          </set-header>
          <set-header name="x-demo-cache" exists-action="override">
            <value>BYPASS</value>
          </set-header>
          <set-header name="x-demo-cache-type" exists-action="override">
            <value>@((string)context.Variables["cacheType"])</value>
          </set-header>
          <set-header name="x-demo-cache-eligible" exists-action="override">
            <value>false</value>
          </set-header>
          <set-header name="x-demo-generation" exists-action="override">
            <value>{{rag-knowledge-generation}}</value>
          </set-header>
          <set-body>@("{\"error\":\"too_long\",\"message\":\"question exceeds the configured character limit\",\"correlationId\":\"" + (string)context.Variables["correlationId"] + "\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <!-- 4. Exact cache identity.

         Normalization contract (must stay identical to
         query/rag/normalize.py::normalize_question):
             trim -> collapse every internal whitespace run to a single space
             -> Unicode-preserving lowercase.

         Key layout (query/rag/normalize.py::build_cache_identity):
             rag-response:v1:scope:{s}:generation:{g}:prompt:{p}:model:{m}:query:{sha256}

         Only the first 16 hex characters of SHA-256(cacheKey) ever leave the
         gateway, so no raw question, prompt, or document text is exposed.

         A failure here degrades to an ineligible (never-cached) request that
         still reaches the backend, rather than failing the call. -->
    <set-variable name="cacheKey" value='@{
      try {
        var raw = (string)context.Variables["questionRaw"];
        var normalized = System.Text.RegularExpressions.Regex.Replace(raw.Trim(), @"\s+", " ").ToLowerInvariant();
        var hasher = System.Security.Cryptography.SHA256.Create();
        var digest = hasher.ComputeHash(System.Text.Encoding.UTF8.GetBytes(normalized));
        var questionHash = BitConverter.ToString(digest).Replace("-", string.Empty).ToLowerInvariant();
        return "rag-response:v1:scope:{{rag-security-scope}}:generation:{{rag-knowledge-generation}}:prompt:{{rag-prompt-version}}:model:{{rag-logical-model-version}}:query:" + questionHash;
      } catch (Exception) {
        return "";
      }
    }' />

    <set-variable name="cacheKeyId" value='@{
      try {
        var key = (string)context.Variables["cacheKey"];
        if (string.IsNullOrEmpty(key)) { return ""; }
        var hasher = System.Security.Cryptography.SHA256.Create();
        var digest = hasher.ComputeHash(System.Text.Encoding.UTF8.GetBytes(key));
        return BitConverter.ToString(digest).Replace("-", string.Empty).ToLowerInvariant().Substring(0, 16);
      } catch (Exception) {
        return "";
      }
    }' />

    <set-variable name="cacheEligible" value='@(!string.IsNullOrEmpty((string)context.Variables["cacheKey"]) &amp;&amp; context.Request.Method == "POST")' />

    <!-- 5. Backend selection and authentication. Both operations resolve to the
         same backend entity, and the gateway's own user-assigned managed
         identity obtains a token for the query Function App's Entra
         application; no key, secret, or caller-supplied credential is used. -->
    <set-backend-service backend-id="rag-query-backend" />
    <authentication-managed-identity resource="{{rag-backend-audience}}" client-id="{{rag-apim-identity-client-id}}" ignore-error="false" />
  </inbound>

  <backend>
    <forward-request timeout="{{rag-backend-timeout-seconds}}" buffer-request-body="true" />
  </backend>

  <outbound>
    <base />
    <!-- 6. Per-request proof. Gateway values are authoritative for the current
         request even when the body carries the original backend metadata of a
         cached answer. -->
    <set-header name="x-demo-correlation-id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="x-demo-cache" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("cacheOutcome", "BYPASS"))</value>
    </set-header>
    <set-header name="x-demo-cache-type" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("cacheType", "none"))</value>
    </set-header>
    <set-header name="x-demo-cache-eligible" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;bool&gt;("cacheEligible", false) ? "true" : "false")</value>
    </set-header>
    <set-header name="x-demo-cache-key-id" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("cacheKeyId", ""))</value>
    </set-header>
    <set-header name="x-demo-generation" exists-action="override">
      <value>{{rag-knowledge-generation}}</value>
    </set-header>
    <set-header name="x-demo-security-scope" exists-action="override">
      <value>{{rag-security-scope}}</value>
    </set-header>
    <set-header name="x-demo-prompt-version" exists-action="override">
      <value>{{rag-prompt-version}}</value>
    </set-header>
    <set-header name="x-demo-model-version" exists-action="override">
      <value>{{rag-logical-model-version}}</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <!-- A failure anywhere in the pipeline still reports honest cache state.
         A cache-subsystem failure is reported as a fallback, never as a hit. -->
    <set-header name="x-demo-correlation-id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="x-demo-cache" exists-action="override">
      <value>@(context.LastError != null &amp;&amp; context.LastError.Source != null &amp;&amp; context.LastError.Source.ToLowerInvariant().Contains("cache") ? "ERROR-FALLBACK" : context.Variables.GetValueOrDefault&lt;string&gt;("cacheOutcome", "BYPASS"))</value>
    </set-header>
    <set-header name="x-demo-cache-type" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("cacheType", "none"))</value>
    </set-header>
    <set-header name="x-demo-cache-key-id" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("cacheKeyId", ""))</value>
    </set-header>
    <set-header name="x-demo-cache-store" exists-action="override">
      <value>skipped</value>
    </set-header>
    <set-header name="x-demo-generation" exists-action="override">
      <value>{{rag-knowledge-generation}}</value>
    </set-header>
  </on-error>
</policies>
