{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AZURE_FUNCTIONS_ENVIRONMENT": "Development",

    "AZURE_SEARCH_ENDPOINT": "https://<search-resource>.search.windows.net",
    "AZURE_SEARCH_INDEX": "document-chunks",
    "AZURE_SEARCH_API_VERSION": "2024-07-01",

    "AOAI_ENDPOINT": "https://<openai-resource>.openai.azure.com/",
    "AOAI_CHAT_DEPLOYMENT": "gpt-4o-mini",
    "AOAI_EMBEDDING_DEPLOYMENT": "text-embedding-ada-002",
    "AOAI_API_VERSION": "2024-10-21",

    "QUERY_DEFAULT_TOP_K": "8",
    "QUERY_MAX_QUESTION_LENGTH": "2000",

    "QUERY_DEFAULT_GENERATION": "0",
    "QUERY_DEFAULT_SECURITY_SCOPE": "demo-public",
    "QUERY_DEFAULT_PROMPT_VERSION": "v1",
    "QUERY_DEFAULT_MODEL_VERSION": "v1",

    "APPLICATIONINSIGHTS_CONNECTION_STRING": "InstrumentationKey=<key>;IngestionEndpoint=..."
  }
}
